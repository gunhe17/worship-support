{
  "permissions": {
    "deny": [
      "Read(.docker/.env)",
      "Read(**/.env.develop)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.local)",
      "Read(.env/.env.develop)",
      "Read(.env/.env.production)",
      "Read(.env/.env.test)",
      "Read(.env/.env.local)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)"
    ],
    "allow": [
      "Bash(sh script/develop/devcontainer-drop.sh)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
}
