{
  "title": "주남의 사랑",
  "key": "E major",
  "time_signature": "4/4",
  "tempo": "120",
  "sections": [
    {
      "tag": "1",
      "lyrics": "눈 부신 햇살 저하늘 너 내게주어 진 주 남의 사랑 깊어져가 네 나의마음 에",
      "chords": [
        "EM7",
        "D/E",
        "AM7",
        "A/B",
        "EM7"
      ]
    },
    {
      "tag": "2",
      "lyrics": "나 연었네 변함없는 그 사랑",
      "chords": [
        "G#m7",
        "C#m7",
        "F#m7"
      ]
    },
    {
      "tag": "3",
      "lyrics": "내안에 기쁨의 노래 멈출 수가 없네",
      "chords": [
        "D(add9)",
        "A/B",
        "B"
      ]
    },
    {
      "tag": "4",
      "lyrics": "주 남의 사랑 바람에실리듯내게찾아와",
      "chords": [
        "F#m7",
        "B",
        "G#m7",
        "C#m7"
      ]
    },
    {
      "tag": "5",
      "lyrics": "그 사랑의 향기가 내 맘가득해",
      "chords": [
        "F#m7",
        "B"
      ]
    },
    {
      "tag": "6",
      "lyrics": "주남의은혜 굶이쳐흐르며내게다가와",
      "chords": [
        "G#m7",
        "C#m7"
      ]
    },
    {
      "tag": "7",
      "lyrics": "그 사랑의 열매로 내 맘채우네",
      "chords": [
        "F#m7",
        "B",
        "E"
      ]
    }
  ]
}