FROM node:22-slim AS build

ARG API_URL=http://api:8765
ENV API_URL=${API_URL}

WORKDIR /uwi
COPY worship_support/uwi/package.json worship_support/uwi/package-lock.json ./
RUN npm ci
COPY worship_support/uwi ./
RUN npm run build

FROM node:22-slim

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /uwi
COPY --from=build /uwi/.next/standalone ./
COPY --from=build /uwi/.next/static ./.next/static

CMD ["node", "server.js"]
